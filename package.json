{
  "name": "discord-music-downloader",
  "version": "1.0.0",
  "description": "Discord music downloader bot written in TypeScript",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "package": "npm run build && npx pkg dist/index.js --targets node18-win-x64 --output dist/music-downloader.exe"
  },
  "dependencies": {
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "playwright": "^1.45.1",
    "ytdlp-nodejs": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "pkg": "^5.8.1",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
